<header class="px-4 sm:px-6 lg:px-8 bg-[#2F5597]">
  <div class="flex items-center justify-between border-b border-[#4472C4] py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/">
        <h1 class="text-xl font-bold text-white" style="color: white;">AshReports Demo</h1>
      </a>
      <p class="bg-[#4472C4] text-white rounded-full px-2 font-medium leading-6" style="color: white;">
        v<%= Application.spec(:ash_reports, :vsn) %>
      </p>
    </div>
    <div class="flex items-center gap-4 font-semibold leading-6 text-white">
      <a href="/reports" class="hover:text-[#B4C6E7]" style="color: white;">Reports</a>
      <a href="/dashboard" class="hover:text-[#B4C6E7]" style="color: white;">Dashboard</a>
      <a href="/charts" class="hover:text-[#B4C6E7]" style="color: white;">Charts</a>
      <a
        href="https://github.com/ash-project/ash_reports"
        class="rounded-lg bg-[#4472C4] px-2 py-1 hover:bg-[#203764]"
        style="color: white;"
      >
        GitHub <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</header>
<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  </div>
</main>