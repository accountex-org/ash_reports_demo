#!/bin/sh

# Configure release node for Fly.io clustering
# Sets up IPv6 distribution and node naming

# Enable IPv6 for Erlang distribution
export ERL_AFLAGS="-proto_dist inet6_tcp"

# Configure release distribution
export RELEASE_DISTRIBUTION="name"

# Set node name using Fly.io environment variables
if [ -n "$FLY_APP_NAME" ] && [ -n "$FLY_PRIVATE_IP" ]; then
  export RELEASE_NODE="${FLY_APP_NAME}@${FLY_PRIVATE_IP}"
fi
